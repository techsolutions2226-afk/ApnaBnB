# Production backend environment file (DO NOT COMMIT)
# Copy this to .env and fill in production values

PORT=5000
JWT_SECRET=your_production_jwt_secret_key_here

# Supabase PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Cloudinary Configuration (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=property_images
CLOUDINARY_UPLOAD_PRESET=ApnaBnB

# Google Maps (server-side geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# SMTP (Gmail App Password) for OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ApnaBnB Verification <your_email@gmail.com>"

# Frontend URL for CORS and email links (set this AFTER Vercel deployment)
FRONTEND_URL=https://your-vercel-app.vercel.app

# AES-256-GCM key for message encryption (64 hex chars = 32 bytes)
MESSAGE_ENC_KEY=your_64_character_hex_key_here_for_message_encryption

# Google Gemini (free tier) for AI matchmaking. Optional — without it the
# platform falls back to pure rule-based matching. Get a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
