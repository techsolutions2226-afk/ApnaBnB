# Production backend environment file (DO NOT COMMIT)
# Copy this to .env and fill in production values

PORT=5000
JWT_SECRET=your_production_jwt_secret_key_here

# Supabase PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Cloudinary Configuration (image uploads)
# Folder layout: apnaBnB/properties · apnaBnB/profile-images
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=apnaBnB/properties
CLOUDINARY_PROFILE_FOLDER=apnaBnB/profile-images
CLOUDINARY_VIDEO_FOLDER=apnaBnB/videos
# Do not set CLOUDINARY_UPLOAD_PRESET for this API — uploads are signed with
# CLOUDINARY_API_KEY / SECRET. A missing/wrong preset returns HTTP 400
# "Upload preset not found".

# Google Maps (server-side geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Trust the reverse proxy in front of the app (Render, Vercel, Nginx, tunnels)
# so the visitor's REAL IP is used instead of the proxy's. Without it every
# visitor looks like they are in one city and the home page rows are wrong.
# Unset = on when NODE_ENV=production. Set TRUST_PROXY=1 when the app is behind
# a proxy without NODE_ENV=production; TRUST_PROXY=0 when it is not proxied.
# TRUST_PROXY=1

# IP geolocation (ipapi.co) — default home search city from the visitor's IP.
# Optional: works without a key at low volume; a key raises the quota.
# IPAPI_KEY=your_ipapi_key
# Dev only (ignored when NODE_ENV=production): pretend requests come from this
# public IP, since local requests arrive from loopback and cannot be located.
# GEO_DEV_IP=

# Google OAuth "Continue with Google" — OAuth 2.0 Client ID (Web application).
# Used to verify the ID token's `aud` claim on POST /api/auth/google.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP (Gmail App Password) for OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ApnaBnB Verification <your_email@gmail.com>"

# Mail transport. Leave unset (or "smtp") to send over SMTP with the settings
# above — this is the normal local setup.
#
# Set to "brevo" on hosts that block outbound SMTP (Render's free tier does,
# so a send there hangs until it times out). Brevo delivers over HTTPS :443,
# which is never blocked. SMTP_FROM is still used for the sender identity, so
# verify that exact address in Brevo first.
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=your_brevo_api_key

# Frontend URL for CORS and email links (set this AFTER Vercel deployment)
FRONTEND_URL=https://your-vercel-app.vercel.app


# Google Gemini (free tier) for AI matchmaking. Optional — without it the
# platform falls back to pure rule-based matching. Get a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
